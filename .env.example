# SamayYudh 2.0 — Environment Variables
# Copy this file to .env.local and fill in the values

# ── 1. PRIMARY APP DATABASE (Required for Auth & Student Cloud Sync) ──────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase Service Role key (NEVER expose with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# ── 2. SEPARATE DATABASES ARCHITECTURE (Optional Multi-Database Partitioning) ──
# By default, SamayYudh 2.0 operates in Unified Database Mode where all tables live
# in the primary Supabase database.
# To isolate Admin Command Center / Institutional data from the public Student Exam platform,
# configure dedicated database instances and/or schemas below:
#
# Dedicated Admin / Command Center Database:
# ADMIN_SUPABASE_URL=https://<your-admin-project-id>.supabase.co
# ADMIN_SUPABASE_ANON_KEY=...
# ADMIN_SUPABASE_SERVICE_ROLE_KEY=...
# ADMIN_DB_SCHEMA=public # or 'admin'
#
# Dedicated Analytics / Security Audit Database:
# ANALYTICS_SUPABASE_URL=https://<your-analytics-project-id>.supabase.co
# ANALYTICS_SUPABASE_SERVICE_ROLE_KEY=...
# ANALYTICS_DB_SCHEMA=public

# ── 3. ADMIN & TEACHER COMMAND CENTER GATEWAY ───────────────────────────────────
# Server-only — NEVER prefix with NEXT_PUBLIC
# Set ADMIN_COMMAND_PASSKEY (plain server secret) OR ADMIN_COMMAND_PASSKEY_HASH (SHA-256 hex digest)
ADMIN_COMMAND_PASSKEY=
# Optional comma-separated bootstrap super_admin email list + HMAC signing secret for command sessions
ADMIN_COMMAND_SESSION_SECRET=
SUPER_ADMIN_EMAILS=

# ── 4. UPSTASH REDIS CACHING & DISTRIBUTED LOAD BALANCING ──────────────────────
# Free Serverless Redis: sign up at https://console.upstash.com, create a Redis database, and copy REST URL & Token.
# (If omitted, app automatically operates with In-Memory Cluster Fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 5. AI ENGINES ─────────────────────────────────────────────────────────────
# Gemini AI (required for descriptive answer evaluation)
GEMINI_API_KEY=

# SOKHA AI Study Companion (dedicated key to isolate chatbot quotas from exam evaluations)
SOKHA_GEMINI_API_KEY=

# ── 6. PAYMENT GATEWAYS ────────────────────────────────────────────────────────
# Payment Gateway 1: Razorpay (Free Test Mode available out of the box)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_Tlix2vclEDoazj
RAZORPAY_KEY_ID=rzp_test_Tlix2vclEDoazj
RAZORPAY_KEY_SECRET=69vUWJwfLJImUpuI6EOBzsxo

# Payment Gateway 2: Cashfree (Free Sandbox Mode available at merchant.cashfree.com)
NEXT_PUBLIC_CASHFREE_APP_ID=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
NEXT_PUBLIC_CASHFREE_MODE=sandbox # 'sandbox' or 'production'
